# Camera
# Only these packages see the auxiliary camera IDs (2 and 3). Everyone else gets cameras 0
# and 1, as on stock. Without this every app sees camera 2, a logical camera whose
# zoomRatioRange the HAL leaves invalid, and CameraX in Google apps fails on it.
vendor.camera.aux.packagelist=com.android.camera,org.lineageos.aperture,org.codeaurora.snapcam

# CNE
persist.vendor.cne.feature=1

# GNSS
persist.sys.gps.selfRecovery=3
persist.vendor.overlay.izat.optin=rro

# Media
media.stagefright.thumbnail.prefer_hw_codecs=true
ro.media.xml_variant.profiles=_blair

# Radio
ril.subscription.types=NV,RUIM
ro.telephony.default_network=33,33
telephony.lteOnCdmaDevice=1

# Wi-Fi Display
persist.debug.wfd.enable=1
