install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_WCNSS_qcom_cfg.ini_symlink",
    installed_location: "firmware/wlan/qca_cld/WCNSS_qcom_cfg.ini",
    symlink_target: "/odm/etc/wifi/WCNSS_qcom_cfg.ini",
    device_specific: true,
}

install_symlink {
    name: "CneApp.libvndfwk_detect_jni.qti_vendor_symlink",
    vendor: true,
    installed_location: "app/CneApp/lib/arm64/libvndfwk_detect_jni.qti.so",
    symlink_target: "/vendor/lib64/libvndfwk_detect_jni.qti.so",
}

// Install the template used to initialize fresh /data/vendor/wifi/wpa configs.
prebuilt_etc {
    name: "spring_wpa_supplicant_conf",
    src: ":wpa_supplicant_conf_gen",
    filename: "wpa_supplicant.conf",
    relative_install_path: "wifi",
    vendor: true,
}

// Kernel UAPI headers from the prebuilt kernel (device/xiaomi/spring-kernel).
// spring-kernel-headers and kernel-headers-audio are symlinks to that repo, so the
// kernel repo stays stock. Do not name the first one "kernel-headers": the build
// adds $(TARGET_DEVICE_DIR)/kernel-headers to every module as -isystem, and
// those raw headers clash with bionic. cleaned-headers comes first: it carries three
// headers (asm/signal.h, asm-generic/signal.h, linux/eventpoll.h) without the
// definitions that clash with bionic (struct sigaction, epoll_event).
cc_library_headers {
    name: "generated_kernel_headers",
    vendor_available: true,
    recovery_available: true,
    export_include_dirs: [
        "cleaned-headers",
        "spring-kernel-headers",
        "kernel-headers-audio",
    ],
}

cc_defaults {
    name: "generated_kernel_header_defaults",
    vendor_available: true,
    recovery_available: true,
    header_libs: ["generated_kernel_headers"],
    export_header_lib_headers: ["generated_kernel_headers"],
}

cc_library_headers {
    name: "audio_kernel_headers",
    defaults: ["generated_kernel_header_defaults"],
}

cc_library_headers {
    name: "qti_audio_kernel_uapi",
    defaults: ["generated_kernel_header_defaults"],
}

cc_library_headers {
    name: "qti_display_kernel_headers",
    defaults: ["generated_kernel_header_defaults"],
}

cc_library_headers {
    name: "qti_ipa_kernel_headers",
    defaults: ["generated_kernel_header_defaults"],
}

cc_library_headers {
    name: "qti_kernel_headers",
    defaults: ["generated_kernel_header_defaults"],
}

cc_library_headers {
    name: "smmu_proxy_uapi_header",
    defaults: ["generated_kernel_header_defaults"],
}

// Audio HAL multilib default, selected by the android_hardware_audio soong
// config set in device.mk.
soong_config_module_type {
    name: "android_hardware_qtiaudio_config_default",
    module_type: "cc_defaults",
    config_namespace: "android_hardware_audio",
    bool_variables: [
        "run_64bit",
    ],
    properties: ["compile_multilib"],
}

android_hardware_qtiaudio_config_default {
    name: "android_hardware_qtiaudio_config_defaults",

    soong_config_variables: {
        run_64bit: {
            compile_multilib: "64",
        },
    },
}
